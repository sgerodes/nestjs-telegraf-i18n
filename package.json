{
  "name": "nestjs-telegraf-i18n",
  "version": "1.2.8",
  "description": "I18n integration for NestJS Telegraf",
  "author": "Sergey Gerodes <gerodes.it@gmail.com> (https://sergeygerodes.xyz/)",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "format": "prettier --write src/**/*.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "build": "tsc",
    "version:patch": "pnpm version patch",
    "version:minor": "pnpm version minor",
    "prepublishOnly": "pnpm run build",
    "test": "jest",
    "test:verbose": "DEBUG_TESTS=1 jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/jest.setup.ts"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/testing": "^10.4.22",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.0",
    "@typescript-eslint/eslint-plugin": "^8.27.0",
    "@typescript-eslint/parser": "^8.27.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-import": "^2.31.0",
    "jest": "^29.7.0",
    "nestjs-i18n": "^10.5.0",
    "nestjs-telegraf": "^2.8.1",
    "nestjs-telegraf-i18n": "^0.4.1",
    "prettier": "^3.5.3",
    "telegraf": "^4.16.3",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "@nestjs/common": "^9.0.0 || ^10.0.0",
    "@nestjs/core": "^9.0.0 || ^10.0.0",
    "nestjs-i18n": "^10.5.0",
    "nestjs-telegraf": "^2.8.1",
    "telegraf": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": false
    },
    "@nestjs/core": {
      "optional": false
    },
    "nestjs-i18n": {
      "optional": false
    },
    "nestjs-telegraf": {
      "optional": false
    },
    "telegraf": {
      "optional": false
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sgerodes/nestjs-telegraf-i18n.git"
  },
  "bugs": {
    "url": "https://github.com/sgerodes/nestjs-telegraf-i18n/issues"
  },
  "keywords": [
    "nestjs",
    "nest",
    "nestjs-module",
    "nestjs-i18n",
    "nestjs-telegraf",
    "telegraf",
    "telegram",
    "telegram bot",
    "bot",
    "i18n",
    "internationalization",
    "internationalisation",
    "localization",
    "localisation",
    "translation",
    "multilingual",
    "language",
    "locale",
    "middleware"
  ]
}
